# Export this variable before running the API; .env is not loaded automatically.
APP_PORT=8080

# Local development only. Keep DATABASE_URL in sync if these values change.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local
POSTGRES_DB=sentinel
POSTGRES_PORT=5433
DATABASE_URL=postgres://sentinel:sentinel_local@127.0.0.1:5433/sentinel?sslmode=disable

# Number of governed re-analysis cycles allowed after the initial analysis.
MAX_REANALYSIS=3
