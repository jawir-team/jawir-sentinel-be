# Copy to .env for local development. Values below are local-only examples;
# never put production credentials or service-account keys in this file.

# Process settings. APP_ENV is reserved for deployment metadata; the current
# Go binaries do not branch on it.
APP_ENV=development
APP_PORT=8080

# Local PostgreSQL/pgvector. Compose overrides DATABASE_URL to use the
# container hostname while host-run Go processes use 127.0.0.1:5433.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local
POSTGRES_DB=sentinel
POSTGRES_PORT=5433
DATABASE_URL=postgres://sentinel:sentinel_local@127.0.0.1:5433/sentinel?sslmode=disable

# Local RabbitMQ. Compose overrides RABBITMQ_URL to use the container hostname.
RABBITMQ_DEFAULT_USER=sentinel
RABBITMQ_DEFAULT_PASS=sentinel_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://sentinel:sentinel_local@127.0.0.1:5672/
RABBITMQ_AI_QUEUE=sentinel.ai_analysis

# Firebase project ID is not a secret. Authentication uses Application Default
# Credentials; configure a local ADC identity separately.
FIREBASE_PROJECT_ID=local-firebase-project

# Google Cloud / Vertex AI identifiers. GCP_REGION and POLICY_RETRIEVAL_TOP_K
# are documented deployment settings but are not currently consumed by code.
GCP_PROJECT_ID=local-gcp-project
GCP_REGION=asia-southeast2
VERTEX_AI_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001

# Cloud Storage. Leave credential secrets empty. Prefer ADC/service identity;
# the JSON option exists for signed-upload URL support in the current code.
GCS_BUCKET=local-sentinel-evidence
GCS_SIGNED_URL_TTL_SECONDS=900
GCS_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Workflow/retry tuning.
MAX_REANALYSIS=3
AI_TECHNICAL_MAX_RETRIES=3
POLICY_RETRIEVAL_TOP_K=8
POLICY_INDEX_LEASE_SECONDS=900
AI_WORKER_LEASE_SECONDS=300
